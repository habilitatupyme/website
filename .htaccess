# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/habilita/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/habilita/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# BEGIN Habilita tu PYME
# ---------------------------------------------------------------------------------------------
# Generado por scripts/generate-routes.js a partir de app.js (PATHS), sitemap.config.json y
# vercel.json. NO EDITAR A MANO: cambie esos archivos y ejecute  node scripts/generate-routes.js
#
# Los bloques "BEGIN cPanel-generated ... END cPanel-generated" que cPanel agrega por su cuenta
# (por ejemplo desde MultiPHP INI Editor) pueden convivir ARRIBA de este bloque: el generador los
# conserva tal cual. No ponga reglas propias fuera de este bloque.
# Comprobar el resultado:  bash scripts/verify-urls.sh https://www.habilitatupyme.cl
# ---------------------------------------------------------------------------------------------

# Página de inicio, sin listado de carpetas ni negociación de contenido (/index no debe abrir index.html)
DirectoryIndex index.html
Options -Indexes -MultiViews

# 404 real (código 404) con la página propia del sitio
ErrorDocument 404 /404.html

# Codificación UTF-8 en los tipos de texto (igual que Vercel)
AddDefaultCharset utf-8
AddCharset utf-8 .js .css .json .xml .svg .txt

RewriteEngine On
RewriteBase /

# 1. /.well-known/ (validación del certificado AutoSSL): sin redirecciones ni bloqueos, nunca.
#    Se mira la ruta actual y también THE_REQUEST (la línea original "GET /.well-known/... HTTP/1.1"),
#    que no cambia cuando el servidor salta por dentro a /404.html (ErrorDocument): así un archivo
#    inexistente en /.well-known/ responde 404 directo, sin redirigir a https ni a /404.html.
RewriteRule ^\.well-known(/|$) - [L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+\.well-known(/|\s|\?) [NC]
RewriteRule ^ - [L]

# 2. Archivos internos y ocultos: acceso prohibido (403)
RewriteRule (^|/)\. - [F,L]
RewriteRule ^scripts(/|$) - [F,L]
RewriteRule ^(sitemap\.config\.json|vercel\.json|package[^/]*\.json)$ - [F,L]
RewriteRule ^(README|CLAUDE) - [NC,F,L]

# 3. Dominio canónico: habilitatupyme.cl -> www.habilitatupyme.cl y http -> https, en un solo salto,
#    conservando ruta y parámetros (gclid, utm_*, etc.). HTTPS se detecta también por las cabeceras
#    de Cloudflare (X-Forwarded-Proto / CF-Visitor) para no crear bucles detrás del proxy.
#    Todas las redirecciones (3, 4 y 5) llevan  RewriteCond %{ENV:REDIRECT_STATUS} ^$ : solo se aplican a
#    la petición original del visitante, nunca a los saltos internos (404.html, archivos .html).
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{THE_REQUEST} !^[A-Z]+\s/+\.well-known(/|\s|\?) [NC]
RewriteCond %{HTTP_HOST} ^habilitatupyme\.cl\.?(:[0-9]+)?$ [NC]
RewriteRule ^ https://www.habilitatupyme.cl%{REQUEST_URI} [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{THE_REQUEST} !^[A-Z]+\s/+\.well-known(/|\s|\?) [NC]
RewriteCond %{HTTP_HOST} ^www\.habilitatupyme\.cl\.?(:[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP:CF-Visitor} !https [NC]
RewriteRule ^ https://www.habilitatupyme.cl%{REQUEST_URI} [R=301,L]

# 4. Barra final: /ruta/ -> /ruta (Vercel: "trailingSlash": false). La portada / no se toca.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(.*[^/])/+$ /$1 [R=301,L]

# 5. Alias antiguos (redirects de vercel.json / sitemap.config.json)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^constitucion-empresa$ /empresa-en-un-dia [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^modificacion-estatutos$ /modificacion-de-estatutos [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^inicio$ / [R=301,L]

# 6. Rutas limpias sin .html (rewrites de vercel.json): la URL no cambia, se sirve el archivo
RewriteRule ^empresa-en-un-dia$ empresa-en-un-dia.html [L]
RewriteRule ^modificacion-de-estatutos$ modificacion-de-estatutos.html [L]
RewriteRule ^oficina-virtual$ oficina-virtual.html [L]
RewriteRule ^patente-municipal$ patente-municipal.html [L]
RewriteRule ^certificado-digital$ certificado-digital.html [L]
RewriteRule ^modificacion-de-estatutos/facultades-de-administracion$ modificacion-de-estatutos--facultades-de-administracion.html [L]
RewriteRule ^modificacion-de-estatutos/cambio-de-giro$ modificacion-de-estatutos--cambio-de-giro.html [L]
RewriteRule ^modificacion-de-estatutos/cambio-de-representante-legal$ modificacion-de-estatutos--cambio-de-representante-legal.html [L]
RewriteRule ^modificacion-de-estatutos/cambio-de-accionistas$ modificacion-de-estatutos--cambio-de-accionistas.html [L]
RewriteRule ^modificacion-de-estatutos/transformacion-spa-a-eirl-o-srl$ modificacion-de-estatutos--transformacion-spa-a-eirl-o-srl.html [L]
RewriteRule ^modificacion-de-estatutos/modificacion-de-eirl-y-srl$ modificacion-de-estatutos--modificacion-de-eirl-y-srl.html [L]
RewriteRule ^preguntas-frecuentes$ preguntas-frecuentes.html [L]
RewriteRule ^blog$ blog.html [L]
RewriteRule ^terminos-y-condiciones$ terminos-y-condiciones.html [L]
RewriteRule ^informacion-legal$ informacion-legal.html [L]

# 7. Cabeceras de seguridad y caché en todas las respuestas (también 404 y redirecciones)
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://*.google.com https://*.googleapis.com https://*.google-analytics.com https://*.googletagmanager.com https://googleadservices.com https://*.googleadservices.com https://doubleclick.net https://*.doubleclick.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.googleapis.com; font-src 'self' https://fonts.gstatic.com https://*.gstatic.com data:; img-src 'self' data: https://images.unsplash.com https://unsplash.com https://*.google.com https://google.com https://*.googleapis.com https://*.googleusercontent.com https://*.google-analytics.com https://*.googletagmanager.com https://googleadservices.com https://*.googleadservices.com https://doubleclick.net https://*.doubleclick.net; connect-src 'self' https://api.web3forms.com https://*.google.com https://*.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://googleadservices.com https://*.googleadservices.com https://doubleclick.net https://*.doubleclick.net https://cloudflareinsights.com; frame-src 'self' https://*.google.com https://*.doubleclick.net https://doubleclick.net; frame-ancestors 'none'; base-uri 'self'; object-src 'none';"
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=63072000"
Header always set Cache-Control "public, max-age=0, must-revalidate"

# END Habilita tu PYME
