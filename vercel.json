{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/constitucion-empresa",
      "destination": "/empresa-en-un-dia",
      "permanent": true
    },
    {
      "source": "/modificacion-estatutos",
      "destination": "/modificacion-de-estatutos",
      "permanent": true
    },
    {
      "source": "/inicio",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/empresa-en-un-dia",
      "destination": "/empresa-en-un-dia.html"
    },
    {
      "source": "/modificacion-de-estatutos",
      "destination": "/modificacion-de-estatutos.html"
    },
    {
      "source": "/modificacion-de-estatutos/facultades-de-administracion",
      "destination": "/modificacion-de-estatutos--facultades-de-administracion.html"
    },
    {
      "source": "/modificacion-de-estatutos/cambio-de-giro",
      "destination": "/modificacion-de-estatutos--cambio-de-giro.html"
    },
    {
      "source": "/modificacion-de-estatutos/cambio-de-representante-legal",
      "destination": "/modificacion-de-estatutos--cambio-de-representante-legal.html"
    },
    {
      "source": "/modificacion-de-estatutos/cambio-de-accionistas",
      "destination": "/modificacion-de-estatutos--cambio-de-accionistas.html"
    },
    {
      "source": "/modificacion-de-estatutos/transformacion-spa-a-eirl-o-srl",
      "destination": "/modificacion-de-estatutos--transformacion-spa-a-eirl-o-srl.html"
    },
    {
      "source": "/modificacion-de-estatutos/modificacion-de-eirl-y-srl",
      "destination": "/modificacion-de-estatutos--modificacion-de-eirl-y-srl.html"
    },
    {
      "source": "/oficina-virtual",
      "destination": "/oficina-virtual.html"
    },
    {
      "source": "/patente-municipal",
      "destination": "/patente-municipal.html"
    },
    {
      "source": "/certificado-digital",
      "destination": "/certificado-digital.html"
    },
    {
      "source": "/preguntas-frecuentes",
      "destination": "/preguntas-frecuentes.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/terminos-y-condiciones",
      "destination": "/terminos-y-condiciones.html"
    },
    {
      "source": "/informacion-legal",
      "destination": "/informacion-legal.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://*.google.com https://*.googleapis.com https://*.google-analytics.com https://*.googletagmanager.com https://googleadservices.com https://*.googleadservices.com https://doubleclick.net https://*.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.googleapis.com; font-src 'self' https://fonts.gstatic.com https://*.gstatic.com data:; img-src 'self' data: https://images.unsplash.com https://unsplash.com https://*.google.com https://google.com https://*.googleapis.com https://*.googleusercontent.com https://*.google-analytics.com https://*.googletagmanager.com https://googleadservices.com https://*.googleadservices.com https://doubleclick.net https://*.doubleclick.net; connect-src 'self' https://api.web3forms.com https://*.google.com https://*.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://googleadservices.com https://*.googleadservices.com https://doubleclick.net https://*.doubleclick.net; frame-src 'self' https://*.google.com https://*.doubleclick.net https://doubleclick.net; frame-ancestors 'none'; base-uri 'self'; object-src 'none';"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
